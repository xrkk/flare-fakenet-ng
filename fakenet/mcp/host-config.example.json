{
  "schema": "fakenetng-host-mcp.config.v1",
  "fakenet_mcp": {
    "url": "http://<dedicated-vm-guest-ip>:28788/mcp",
    "controller_id": "<current-run-controller-uuid>",
    "config_name": "default.ini",
    "timeout_seconds": 20,
    "allowed_hosts": [
      "<dedicated-vm-guest-ip>"
    ]
  },
  "windows_mcp": {
    "url": "http://<dedicated-vm-guest-ip>:28787/mcp",
    "timeout_seconds": 45,
    "allowed_hosts": [
      "<dedicated-vm-guest-ip>"
    ]
  },
  "velo_mcp": {
    "url": "http://<dedicated-vm-guest-ip>:28790/mcp",
    "tool": "<verified-read-only-velo-tool>",
    "arguments": {},
    "timeout_seconds": 15,
    "allowed_hosts": [
      "<dedicated-vm-guest-ip>"
    ],
    "allowed_tools": [
      "<verified-read-only-velo-tool>"
    ],
    "allowed_arguments": []
  },
  "vmx": {
    "path": "<absolute-vmx-path>",
    "expected_uuid": "<vmx-bios-uuid>",
    "expected_computer": "<guest-computer-name>"
  },
  "guest_ip": "<dedicated-vm-guest-ip>",
  "vmware_networking_path": "/etc/vmware/networking",
  "nat_conf_path": "/etc/vmware/vmnet8/nat/nat.conf",
  "interface": "vmnet8",
  "sample_context": {},
  "probe_authorization": {
    "authorized": false,
    "source_ref": "<absolute-probe-scope-json>",
    "source_sha256": "<probe-scope-json-sha256>",
    "scope": "dedicated-benign-win10",
    "expected_vmx_uuid": "<vmx-bios-uuid>",
    "expected_computer": "<guest-computer-name>"
  },
  "policy": {
    "required_control_ports": [
      28787,
      28788,
      28790
    ],
    "matrix_version": "v1",
    "probe_script_sha256": "16a50f7027a0efd062026e957fdce0bf4b2418e60392261153fb4a3f8820fb94",
    "verification_budget_seconds": 50,
    "guest_budget_ms": 15000,
    "output_compact_limit_bytes": 65536,
    "qualification_profile": "ipv4-v1",
    "required_matrix_ids": [
      "ipv4_tcp_80",
      "ipv4_tcp_443",
      "ipv4_tcp_139",
      "ipv4_tcp_random",
      "ipv4_udp_53",
      "ipv4_udp_443",
      "ipv4_udp_67",
      "ipv4_udp_68",
      "ipv4_udp_137",
      "ipv4_udp_138",
      "ipv4_udp_1900",
      "ipv4_udp_5355",
      "ipv4_udp_random",
      "ipv4_icmp",
      "ipv4_dns_nonce_invalid"
    ],
    "diagnostic_matrix_ids": [
      "ipv6_tcp_80",
      "ipv6_tcp_443",
      "ipv6_tcp_139",
      "ipv6_tcp_random",
      "ipv6_udp_53",
      "ipv6_udp_443",
      "ipv6_udp_67",
      "ipv6_udp_68",
      "ipv6_udp_137",
      "ipv6_udp_138",
      "ipv6_udp_1900",
      "ipv6_udp_5355",
      "ipv6_udp_random",
      "ipv6_icmp",
      "ipv6_dns_nonce_invalid"
    ]
  },
  "output_root": "/var/lib/fakenetng-host-mcp/verifications",
  "state_root": "/var/lib/fakenetng-host-mcp/state",
  "passive_observation": {
    "enabled": false,
    "calibration_ref": {
      "path": "<absolute-program-generated-visibility-receipt>",
      "sha256": "<receipt-sha256>"
    }
  },
  "connectivity_endpoint": null
}
